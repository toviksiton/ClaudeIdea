generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// חומרי גלם / מרכיבים
model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String
  unit        String
  quantity    Float    @default(0)
  alertLevel  Float    @default(5)
  costPerUnit Float    @default(0) // עלות ליחידה (₪)
  supplierId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItemIngredients MenuItemIngredient[]
  supplier            Supplier?  @relation(fields: [supplierId], references: [id])
  purchases           Purchase[]
}

// פריטי תפריט
model MenuItem {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  price            Float
  imageUrl         String?
  category         String   @default("כללי")
  isActive         Boolean  @default(true)
  isAvailable      Boolean  @default(true)
  sortOrder        Int      @default(0)
  prepTimeMinutes  Int      @default(0) // זמן הכנה בדקות
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ingredients MenuItemIngredient[]
  orderItems  OrderItem[]
}

// קישור בין פריט תפריט למרכיבים
model MenuItemIngredient {
  id           Int    @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Float

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
}

// הזמנות
model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerPhone String
  notes         String?
  status        String   @default("PENDING")
  paymentMethod String
  paymentStatus String   @default("PENDING")
  paymentRef    String?
  totalAmount   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

// פריטים בהזמנה
model OrderItem {
  id         Int    @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  priceEach  Float
  notes      String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

// ספקים
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients Ingredient[]
  purchases   Purchase[]
}

// קניות מספקים (מעדכן מלאי + עלות)
model Purchase {
  id           Int      @id @default(autoincrement())
  supplierId   Int?
  ingredientId Int?
  description  String
  quantity     Float    @default(0)
  costPerUnit  Float    @default(0) // עלות ששולמה ליחידה
  totalAmount  Float
  date         DateTime @default(now())
  notes        String?
  vatIncluded  Boolean  @default(true) // האם כולל מע"מ
  createdAt    DateTime @default(now())

  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])
}

// הוצאות כלליות
model Expense {
  id          Int      @id @default(autoincrement())
  category    String   // ציוד, שכר, שיווק, אחר...
  description String
  amount      Float
  vatAmount   Float    @default(0) // מע"מ בתוך הסכום
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
}

// הגדרות מערכת
model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// מועדון לקוחות
model ClubMember {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  birthday  String?  // "DD/MM" format
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// הודעות מערכת (מוצגות בדף הפתיחה)
// type: INFO | PROMO | ALERT
model SystemMessage {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  type      String   @default("INFO")
  emoji     String   @default("📢")
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// עובדים
// role: CHEF | KITCHEN | DELIVERY | OTHER
// status: ACTIVE | INACTIVE
model Employee {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  role         String   @default("KITCHEN")
  hourlyRate   Float    @default(0)
  status       String   @default("ACTIVE")
  referredById Int?     // מי הביא אותו (חבר מביא חבר)
  referralBonus Float   @default(0) // בונוס שמגיע לממליץ
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  referredBy       Employee?        @relation("Referrals", fields: [referredById], references: [id])
  referrals        Employee[]       @relation("Referrals")
  shiftAssignments ShiftAssignment[]
}

// משמרות
// status: PLANNED | ACTIVE | COMPLETED | CANCELLED
model Shift {
  id        Int      @id @default(autoincrement())
  date      DateTime
  startTime String   // "09:00"
  endTime   String   // "17:00"
  notes     String?
  status    String   @default("PLANNED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ShiftAssignment[]
}

// שיבוץ עובד למשמרת
model ShiftAssignment {
  id          Int     @id @default(autoincrement())
  shiftId     Int
  employeeId  Int
  role        String  // CHEF | KITCHEN | DELIVERY
  hours       Float   @default(0)
  hourlyRate  Float   @default(0)
  bonus       Float   @default(0)
  notes       String?

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([shiftId, employeeId])
}
